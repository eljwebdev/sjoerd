---
import Layout from "../layouts/Layout.astro";
import PortableText from "../components/PortableText.astro";
import { sanityClient } from 'sanity:client';
import { slide, fade } from "astro:transitions";


const data = await sanityClient.fetch(`{
  "infoPage": *[_type == "infoPage"][0]{
    "title": headSeo.pageTitle,
    "metaTitle": headSeo.metaTitle,
    "description": headSeo.metaDescription,
    rows[] {
      label,
      layout,
      text,
      textEntry {
        textEntries[] {
          label,
          content
        }
      },
      textLeft,
      textRight
    }
  },
  "mailAdres": *[_type == "settings"][0].settings.mailAdres
}`);
const { title, metaTitle, description, rows } = data?.infoPage ?? {};
const mailadres = data?.mailAdres ?? '';

const animProject = {
  old: {
    name: "moveX",
    duration: "0.6s",
    easing: "ease-in",
    fillMode: "forwards",       
    direction: "normal",
  },
  new: {
    name: "moveX",
    duration: "0.6s",
    easing: "ease-out",
    direction: "reverse",    
    fillMode: "backwards",       
  },
};

const customTransitionProject = {
  forwards: animProject,
  backwards: animProject,
};

---

<Layout pageTitle={title} metaTitle={metaTitle} pageDescription={description}>

  {rows?.map((row: any) => (
    <section class="section-info-row container--margin-normal" transition:name="customSlide" transition:animate={customTransitionProject}>
      <div class="section-info-row-inner container--grid">
        <div class="info-label uppercase"><h2 class="small-text">{row.label}</h2></div>
        <div class="content-wrapper">

          {row.layout === '1col' && (
            <div class="content">
              {row.text && <PortableText value={row.text} class="big-text" />}
              {row.textEntry?.textEntries?.length > 0 && (
                <ul class="text-entry">
                  {row.textEntry.textEntries.map((entry: any) => (
                    <li>
                      {entry.label && <span class="label small-text uppercase">{entry.label}</span>}
                      {entry.content && <PortableText value={entry.content} class="small-text" />}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}

          {row.layout === '2col' && (
            <>
              <div class="content-col">
                {row.textLeft && <PortableText value={row.textLeft} class="big-text" />}
              </div>
              <div class="content-col">
                {row.textRight && <PortableText value={row.textRight} class="big-text" />}
              </div>
            </>
          )}

        </div>
      </div>
    </section>
  ))}

  <section class="section-info-row container--margin-normal" transition:animate={slide({ duration: "0.5s" })}>
    <div class="section-info-row-inner container--grid">
      <div class="info-label uppercase"><h2 class="small-text">contact</h2></div>
      <div class="content-wrapper">
        <div class="content">
          <p class="big-text">
            <a class="info-page-mail" href={`mailto:${mailadres}`}>{mailadres}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style lang="scss">
  .section-info-row:first-of-type {
    padding-top: 128px;
    @include responsive($md){
      padding-top: 122px;
    }
  }
  .section-info-row:not(:first-of-type) {
    padding-top: 244px;
    @include responsive($md){
      padding-top: 122px;
    }
  }
  .container--grid {
    @include responsive($md){
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
  }
  .info-label {
    grid-column: 1 / 4;
  }
  .content-wrapper {
    grid-column: 4 / 11;

    .text-entry li {
      padding-top: 24px;
      display: flex;
      gap: 16px;
      @include responsiveMin($xl){
        gap: 32px;
      }
      @include responsive($md){
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        .label {
          grid-column: 1 / 2;
        }
        .portable-text-container {
          grid-column: 2 / 4;
        }
      }

    }
  }
  .info-page-mail {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 0.5px;
  }
</style>