---
import { fade } from "astro:transitions";
import { sanityClient } from 'sanity:client';

const navData = await sanityClient.fetch(
  `*[_type == "settings"][0]{
    menu,
    "mailadres": settings.mailAdres
  }`
);
const { menu, mailadres } = navData ?? {};




const path = Astro.url.pathname;
let navClass = '';
let homeClass = '';
let infoClass = '';

if (path === '/') {
  navClass = 'current-home';
  homeClass = 'current';
}

if (path === '/info' || path === '/info/') {
  navClass = 'current-info';
  infoClass = 'current';
}

---
<nav class:list={['nav', 'nav-original', navClass]} transition:animate={fade({ duration: "0.8s" })}>
  <div class="nav--inner container--margin-normal container--grid">
    <div class="left">
      <a class="logo-link" href="/">{menu?.menuTitle}</a>
      <p class="nav__tagline--mob1 mobile">{menu?.tagLineMob1}</p>
      <p class="nav__tagline--mob2 mobile">{menu?.tagLineMob2}</p>
    </div>
    <div id="nav-right" class="right container--grid-ninecols">
      <div class="col col-2">
        <a class:list={['hover-wrapper', 'page-link', homeClass, 'work-link']} href="/">
          <span class="visible-text">{menu?.workTitle}</span>
          <span class="hover-text c-white">{menu?.workTextHover}</span>
        </a>
        <div class:list={['nav__tagline', 'desktop', 'big-text', 'hover-wrapper', infoClass]}>
          <p class="visible-text">{menu?.tagLine}</p>
          <span class="hover-text">{menu?.tagLineHover}</span>
        </div>
      </div>
      <div class="col col-3">
        <a class:list={['hover-wrapper', 'page-link', infoClass, 'info-link']} href="/info">
          <span class="visible-text">{menu?.infoText}</span>
          <span class="hover-text c-white">{menu?.infoTextHover}</span>
        </a>
      </div>
      <div class="col col-4">
        <div class="copy-confirmation big-text">
          <span class="copy-confirmation-text c-white">{menu?.contactTextCopied}</span>
        </div>
        <button class="hover-wrapper copy-button" data-email={mailadres}>
          <span class="visible-text">{menu?.contactText}</span>
          <span class="hover-text c-white">{menu?.contactTextHover}</span>
        </button>
      </div>
    </div>
</nav>

<script is:inline>
  // @ts-nocheck
  (function () {
    const BREAKPOINT = 835;
    let mobileNav = null;
    let resizeController = null;

    function applyLayout() {
      const originalNav = document.querySelector('.nav-original');
      if (!originalNav) return;
      const inner = originalNav.querySelector('.nav--inner');
      const right = document.getElementById('nav-right');

      if (window.innerWidth < BREAKPOINT) {
        if (!mobileNav) {
          mobileNav = document.createElement('nav');
          mobileNav.className = originalNav.className + ' nav-new';
          originalNav.insertAdjacentElement('afterend', mobileNav);
        }
        mobileNav.appendChild(right);
      } else {
        if (mobileNav) {
          inner.appendChild(right);
          mobileNav.remove();
          mobileNav = null;
        }
      }
    }

    function setupLayout() {
      // Tear down previous resize listener before re-attaching
      if (resizeController) resizeController.abort();
      resizeController = new AbortController();
      mobileNav = null; // DOM was swapped, old reference is gone
      applyLayout();
      window.addEventListener('resize', applyLayout, { signal: resizeController.signal });
    }

    function setupCopyButton() {
      const button = document.querySelector('.copy-button');
      if (!button) return;
      button.addEventListener('click', () => {
        const email = button.dataset.email;
        const currentLink = document.querySelector('.page-link.current');
        const confirmation = document.querySelector('.copy-confirmation');
        navigator.clipboard.writeText(email).then(() => {
          if (currentLink) {
            currentLink.classList.add('dim-animation');
            currentLink.addEventListener('animationend', () => {
              currentLink.classList.remove('dim-animation');
            }, { once: true });
          }
          if (confirmation) {
            confirmation.classList.add('confirm-animation');
            confirmation.addEventListener('animationend', () => {
              confirmation.classList.remove('confirm-animation');
            }, { once: true });
          }
        }).catch(err => {
          console.error('Failed to copy email: ', err);
        });
      });
    }

    // Run immediately — nav HTML is already in the DOM at this point,
    // no need to wait for Astro's JS bundle to finish loading.
    setupLayout();
    setupCopyButton();

    // Re-run on each client-side navigation. astro:after-swap fires right after
    // the new page's DOM is in place, before transition animations play —
    // much earlier than astro:page-load, which is what caused the layout flash.
    document.addEventListener('astro:after-swap', () => {
      setupLayout();
      setupCopyButton();
    });
  })();
</script>
