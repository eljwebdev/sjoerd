---
import { urlFor } from '../sanity/lib/image'

interface Props {
  video?: { asset?: { url?: string } }
  videoFallback: { asset?: { url?: string } }
  posterImage: any
  description: string
  hasAudio?: boolean
}

const { video, videoFallback, posterImage, description, hasAudio = false } = Astro.props

const webmUrl = video?.asset?.url
const mp4Url = videoFallback?.asset?.url
const posterUrl = urlFor(posterImage).auto('format').url()
---

<sanity-video>
  <div class="video-wrapper">
    <video
      class="video lozad-video"
      aria-label={description}
      poster={posterUrl}
      playsinline
      autoplay
      muted
      loop
    >
      {webmUrl && <source data-src={webmUrl} type="video/webm" />}
      <source data-src={mp4Url} type="video/mp4" />
    </video>
    {hasAudio && (
      <button class="video-unmute" aria-label="Unmute video">
        unmute
      </button>
    )}
  </div>
</sanity-video>

<script>
    // @ts-nocheck
    class SanityVideoElement extends HTMLElement {
      connectedCallback() {
        this.video = this.querySelector('video');
        this.button = this.querySelector('.video-unmute');

        if (!this.video) return;

        this.setupObserver();
        this.setupAudioButton();
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
          this.observer = null;
        }

        if (this.button && this.buttonHandler) {
          this.button.removeEventListener('click', this.buttonHandler);
        }
      }

      setupObserver() {
        if (this.video.dataset.loaded === 'true') {
          this.playVideo();
          return;
        }

        if (this.observer) {
          this.observer.disconnect();
        }

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            this.loadSources();
            this.playVideo();
            this.observer.unobserve(this.video);
          });
        }, {
          rootMargin: '100px 100px'
        });

        this.observer.observe(this.video);
      }

      loadSources() {
        this.video.querySelectorAll('source[data-src]').forEach((source) => {
          if (!source.getAttribute('src')) {
            source.setAttribute('src', source.dataset.src || '');
          }
        });

        this.video.dataset.loaded = 'true';
        this.video.load();
      }

      playVideo() {
        const startPlayback = () => {
          this.video.play().catch(() => {});
        };

        if (this.video.readyState >= 2) {
          startPlayback();
          return;
        }

        this.video.addEventListener('canplay', startPlayback, { once: true });
      }

      setupAudioButton() {
        if (!this.button) return;

        if (this.buttonHandler) {
          this.button.removeEventListener('click', this.buttonHandler);
        }

        this.buttonHandler = () => {
          this.video.muted = !this.video.muted;
          this.button.textContent = this.video.muted ? 'unmute' : 'mute';
          this.button.setAttribute('aria-label', this.video.muted ? 'Unmute video' : 'Mute video');
        };

        this.button.addEventListener('click', this.buttonHandler);
      }
    }

    if (!customElements.get('sanity-video')) {
      customElements.define('sanity-video', SanityVideoElement);
    }

</script>

<style>
  .video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .video-wrapper video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-unmute {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: none;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    font-size: 0.875rem;
  }
</style>
